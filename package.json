{
  "name": "speech-desk",
  "version": "0.1.4",
  "private": true,
  "description": "Talk2 节点式演讲讲稿与悬浮提词器",
  "keywords": [
    "electron",
    "teleprompter",
    "presentation",
    "speech",
    "react"
  ],
  "homepage": "https://github.com/wuzhuoye666/speech-desk#readme",
  "bugs": {
    "url": "https://github.com/wuzhuoye666/speech-desk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuzhuoye666/speech-desk.git"
  },
  "main": "out/main/index.js",
  "author": "wuzhuoye666",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-mathematics": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xyflow/react": "^12.12.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^12.0.0",
    "dompurify": "^3.4.16",
    "katex": "^0.18.9",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "marked": "^16.0.0",
    "mermaid": "^11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "cn.speechdesk.app",
    "productName": "Talk2",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "win": {
      "icon": "assets/talk2-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "shortcutName": "Talk2",
      "installerIcon": "assets/talk2-icon.ico",
      "uninstallerIcon": "assets/talk2-icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
